---
// Carrusel ligero de reels de Instagram: portadas locales (AVIF/WebP) que abren el reel
// en Instagram. No carga nada de Instagram hasta el clic, así que no afecta el PageSpeed.
// Para actualizar: guarda la portada en src/assets/reels/<id>.jpg y agrega el reel a la lista.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

type Reel = { id: string; title: string };
interface Props {
  reels: Reel[];
  eyebrow: string;
  title: string;
  text?: string;
  profile: string;
  handle: string;
  frente?: string;
  pos: string;
  tint?: boolean;
}
const { reels, eyebrow, title, text, profile, handle, frente, pos, tint = false } = Astro.props;
const covers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/reels/*.jpg', { eager: true });
const items = reels.map((r) => {
  const img = covers[`/src/assets/reels/${r.id}.jpg`]?.default;
  if (!img) throw new Error(`Portada de reel no encontrada: ${r.id}`);
  return { ...r, img };
});
---
<section class:list={['section', 'reels', { 'section--tint': tint }]} aria-roledescription="carrusel" aria-label={title}>
  <div class="container">
    <div class="reels__head">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
        {text && <p class="lede">{text}</p>}
      </div>
      <div class="reels__ctrl">
        <a class="btn btn--ghost reels__follow" href={profile} target="_blank" rel="noopener" data-cta="click_social" data-frente={frente} data-pos={`${pos}-seguir`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Z"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
          Ver más en Instagram
        </a>
        <div class="reels__btns">
          <button type="button" class="reels__btn" data-dir="-1" aria-label="Video anterior"><Icon name="arrow" size={20} class="reels__flip" /></button>
          <button type="button" class="reels__btn" data-dir="1" aria-label="Siguiente video"><Icon name="arrow" size={20} /></button>
        </div>
      </div>
    </div>
  </div>
  <ul class="reels__track" tabindex="0">
    {items.map((r) => (
      <li class="reels__card">
        <a href={`https://www.instagram.com/reel/${r.id}/`} target="_blank" rel="noopener" data-cta="click_social" data-frente={frente} data-pos={`${pos}-reel`}>
          <Picture src={r.img} alt="" formats={['avif', 'webp']} widths={[240, 360]} sizes="(min-width: 700px) 240px, 62vw" quality={60} loading="lazy" decoding="async" />
          <span class="reels__badge">Reel</span>
          <span class="reels__title">{r.title}<span class="sr-only"> (abre en Instagram)</span></span>
        </a>
      </li>
    ))}
  </ul>
  <div class="container">
    <p class="small muted reels__src">Videos de {handle} en Instagram. Se abren en una pestaña nueva.</p>
  </div>
</section>
<script is:inline>
  document.querySelectorAll('.reels:not([data-ready])').forEach(function (sec) {
    sec.dataset.ready = '1';
    var track = sec.querySelector('.reels__track');
    sec.querySelectorAll('.reels__btn').forEach(function (b) {
      b.addEventListener('click', function () {
        var card = track.querySelector('.reels__card');
        var step = card ? card.getBoundingClientRect().width + 16 : 260;
        track.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
      });
    });
  });
</script>
<style>
  .reels { overflow: hidden; }
  .reels__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 32px; }
  .reels__head h2 { max-width: 24ch; margin: 0; }
  .reels__head .lede { max-width: 52ch; margin: 14px 0 0; }
  .reels__ctrl { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .reels__follow { display: inline-flex; align-items: center; gap: 8px; }
  .reels__btns { display: flex; gap: 8px; }
  .reels__btn { display: grid; place-items: center; width: 52px; height: 52px; border: 1.5px solid var(--navy); background: #fff; color: var(--navy); cursor: pointer; transition: background-color .2s, color .2s; }
  .reels__btn:hover { background: var(--navy); color: #fff; }
  .reels__btn :global(.reels__flip) { rotate: 180deg; }
  .reels__track { list-style: none; margin: 0; display: grid; grid-auto-flow: column; grid-auto-columns: min(62vw, 240px); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: max(20px, calc((100vw - var(--max)) / 2 + 20px)); padding: 4px max(20px, calc((100vw - var(--max)) / 2 + 20px)) 20px; scrollbar-width: thin; }
  .reels__track:focus-visible { outline-offset: -3px; }
  .reels__card { scroll-snap-align: start; }
  .reels__card a { position: relative; display: block; aspect-ratio: 9 / 16; border-radius: 18px; overflow: hidden; background: var(--navy); color: #fff; text-decoration: none; }
  .reels__card :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .reels__card a:hover :global(img) { transform: scale(1.04); }
  .reels__card a::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(4, 22, 48, .88) 0%, rgba(4, 22, 48, 0) 46%); pointer-events: none; }
  .reels__badge { position: absolute; top: 12px; left: 12px; z-index: 1; font: 700 .68rem/1 var(--display); letter-spacing: .12em; text-transform: uppercase; padding: 6px 9px; border-radius: 999px; background: rgba(255, 255, 255, .92); color: var(--navy); }
  .reels__title { position: absolute; left: 16px; right: 16px; bottom: 16px; z-index: 1; font: 700 1rem/1.3 var(--display); }
  .reels__src { margin-top: 8px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .reels__card :global(img) { transition: none; } }
</style>
