---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import { doctors, waLink } from '../../data/site';
---
<Base title="Oftalmólogos Especialistas en Tijuana | Oftalmo Visión" description="Conoce a los oftalmólogos de Oftalmo Visión: Dr. Juvenal Guzmán, retinólogo, y Dra. Citlali Carrasco, especialista en párpados. Certificados por el Consejo Mexicano de Oftalmología." frente="equipo">
  <PageHero
    eyebrow="Nuestro equipo"
    title="Oftalmólogos especialistas en Tijuana"
    lede="Cirujanos oftalmólogos certificados por el Consejo Mexicano de Oftalmología, con alta especialidad en distintas áreas del ojo, y un equipo de oftalmólogos de otras subespecialidades que nos apoya."
    photo="doctores-oftalmo-vision-optica"
    photoAlt="Dra. Citlali Carrasco y Dr. Juvenal Guzmán en la óptica de Oftalmo Visión"
    crumbs={[{ label: 'Especialistas' }]}
    wa={waLink('Especialistas · Dudas', 'Hola, no sé con qué especialista agendar:')}
    frente="equipo"
  />
  <section class="section">
    <div class="container grid grid-2">
      <DoctorCard photo="dr-juvenal-guzman-optica-tijuana" alt="Dr. Juvenal Guzmán Cerda, retinólogo" name={doctors.juvenal.name} role="Retina y vítreo" text="Cirujano oftalmólogo con alta especialidad en retina y vítreo por el Instituto Mexicano de Oftalmología, avalado por la UNAM." href={doctors.juvenal.url} tags={['Retinopatía diabética', 'Desprendimiento de retina', 'Vitrectomía', 'Inyecciones intravítreas']} position="60% 30%" />
      <DoctorCard photo="dra-citlali-carrasco-optica-tijuana" alt="Dra. Citlali Carrasco González, oculoplástica" name={doctors.citlali.name} role="Oculoplástica" text="Cirujana oftalmóloga con alta especialidad en órbita, párpados y vía lagrimal por la Universidad Autónoma de Sinaloa." href={doctors.citlali.url} tags={['Blefaroplastia', 'Párpado caído', 'Vía lagrimal', 'Órbita']} position="55% 30%" />
    </div>
    <div class="container">
      <p class="lede eq__more">Además del Dr. Juvenal y la Dra. Citlali, en Oftalmo Visión colaboran oftalmólogos de otras subespecialidades que forman parte de nuestro equipo. Si tu caso lo requiere, te atiende el especialista indicado.</p>
    </div>
  </section>
  <Reviews />
  <CtaBand title="Agenda con el especialista indicado" text="Cuéntanos qué necesitas y te asignamos al doctor correcto." tag="Especialistas · Banda final" message="Hola, quiero agendar una cita. Mi caso es:" frente="equipo" />
</Base>
<style>
  .eq__more { max-width: 62ch; margin: 40px auto 0; text-align: center; }
</style>
